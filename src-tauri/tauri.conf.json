{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SOWL HMS",
  "version": "1.0.0",
  "identifier": "com.sowl-hms",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOWL HMS",
        "width": 1440,
        "height": 900,
         "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
